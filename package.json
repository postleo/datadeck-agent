{
  "name": "datadeck-agent",
  "version": "0.1.0",
  "description": "DataDeck Agent — an AI agent that turns messy CSV/Excel files into clean, analysis-ready data with a plain-language report. Use it via the CLI, HTTP API, SDK, MCP, Telegram, a GitHub repo, or a guided Workspace API.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "datadeck": "./src/cli/index.ts"
  },
  "main": "./src/sdk/index.ts",
  "scripts": {
    "clean": "tsx src/cli/index.ts clean",
    "cli": "tsx src/cli/index.ts",
    "api": "tsx src/api/server.ts",
    "telegram": "tsx src/telegram/bot.ts",
    "mcp": "tsx src/mcp/server.ts",
    "agentcore": "tsx src/agentcore/server.ts",
    "bundle": "esbuild src/agentcore/server.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/server.cjs --external:@aws-sdk/client-s3",
    "chat": "tsx src/cli/index.ts chat",
    "typecheck": "tsc --noEmit",
    "repo:run": "tsx src/repo/run.ts",
    "workspace": "tsx src/workspace/server.ts",
    "demo": "tsx src/cli/index.ts clean examples/messy-sample.csv --out ./out"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@strands-agents/sdk": "^1.0.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jszip": "^3.10.1",
    "multer": "^2.3.0",
    "papaparse": "^5.4.1",
    "telegraf": "^4.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
