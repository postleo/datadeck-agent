# ──────────────────────────────────────────────────────────────
# DataDeck Agent — settings. Copy this file to ".env" and fill in.
# Never commit your real .env.
#
# Good news: the plain cleaning + analysis works with NO settings at all.
# You only need an AI model key for the "smart" reasoning features
# (the CLI chat, the /ask endpoint, repo mode, and the Workspace).
# ──────────────────────────────────────────────────────────────

# --- AI model (pick one) --------------------------------------

# Option A — Google Gemini (default, has a free tier).
# Get a key at https://aistudio.google.com/apikey
DATADECK_PROVIDER=google
GEMINI_API_KEY=
# Model to use. If your key can't use "gemini-2.5-flash", use "gemini-flash-latest".
DATADECK_MODEL_ID=gemini-flash-latest

# Option B — Amazon Bedrock (set DATADECK_PROVIDER=bedrock to use).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# DATADECK_MODEL_ID=us.amazon.nova-lite-v1:0
# DATADECK_REGION=us-east-1

# --- HTTP API -------------------------------------------------
PORT=8787

# --- Telegram bot ---------------------------------------------
# Create a bot with @BotFather and paste its token.
TELEGRAM_BOT_TOKEN=

# --- Workspace (guided) API -----------------------------------
WORKSPACE_PORT=8790
# Folder where guided runs are stored (default: ./.workspace-store)
WORKSPACE_STORE=./.workspace-store

# --- Repo mode folders (optional overrides) -------------------
INBOX_DIR=inbox
PROJECTS_DIR=projects

# --- Optional: email the results (via Resend) -----------------
# Get a key at https://resend.com. Absent = email is simply skipped.
RESEND_API_KEY=
EMAIL_FROM=DataDeck <onboarding@resend.dev>
EMAIL_TO=

# --- Optional: publish the HTML report (via Vercel) -----------
# Absent = publishing is simply skipped.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# --- Optional: public URLs (used to build links in emails) ----
PUBLIC_WORKSPACE_URL=
PUBLIC_APP_URL=
